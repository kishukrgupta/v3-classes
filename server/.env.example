# ══════════════════════════════════════════════
# V3 Classes — Environment Variables
# Copy this file to .env and fill in real values
# ══════════════════════════════════════════════
#
# ⚠️  SECURITY WARNING:
# If any secrets (JWT_SECRET, Cloudinary keys, admin passwords)
# were ever committed to Git, you MUST rotate them immediately.
# Generate new values for all secrets before deploying to production.
#

# Database (PostgreSQL)
# For local development with PostgreSQL:
DATABASE_URL=postgresql://user:password@localhost:5432/v3classes
# For Neon PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/v3classes?sslmode=require

# JWT Authentication
JWT_SECRET=CHANGE-ME-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend URL (for CORS — comma-separated for multiple origins)
FRONTEND_URL=http://localhost:8080

# Server
PORT=5000
NODE_ENV=development

# ── Seed Script Variables (used only when running: node prisma/seed.js) ──
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@v3classes.in
ADMIN_PASSWORD=CHANGE-ME-strong-password
